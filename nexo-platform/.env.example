VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_NAME=Nexo Platform
VITE_APP_URL=http://localhost:5173
# Web Push (PWA): base64url public VAPID key. Generate with scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=your-base64url-public-vapid-key

# Vercel function (api/ics): server-side env vars, set in Vercel project settings.
# The service-role key is privileged — never commit the real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
